<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Configure ASP.NET Core Module for In-Process Hosting -->
      <aspNetCore processPath="dotnet" arguments=".\Platform.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Prevent excessive thread pool growth on shared hosting -->
          <environmentVariable name="COMPlus_ThreadPool_ForceMinWorkerThreads" value="1" />
        </environmentVariables>
      </aspNetCore>
      <!-- Enable compression to reduce bandwidth overhead -->
      <httpCompression>
        <dynamicCompression disableCpuThreshold="90" />
      </httpCompression>
    </system.webServer>
  </location>
</configuration>
